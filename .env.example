# Copy to .env.local (git-ignored) and fill in.

# Login: at least 12 characters, or login stays off.
APP_PASSWORD=
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Supabase (Project settings > API). Server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3: chat logging
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
